# ─────────────────────────────────────────────────────────
# Aetheris-MemOS — 环境变量模板
# 复制为 .env 并填写真实值，切勿提交 .env 到版本库
# ─────────────────────────────────────────────────────────

# JWT 签名密钥（必须设置：认证默认开启，占位/过短或未设置将拒绝启动）
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# Neo4j 数据库密码（与 docker-compose NEO4J_AUTH 保持一致）
NEO4J_PASSWORD=password

# ─────────────────────────────────────────────────────────
# 数据库连接（应用角色 — 默认使用 aetheris_app，NOSUPERUSER NOBYPASSRLS）
#
# ⚠️  OPERATOR PREREQUISITE for EXISTING databases:
#     If the aetheris_app role was created by the migration (not by docker/initdb),
#     it has NO password. The connection will fail with "password authentication failed"
#     until an operator runs:
#
#       ALTER ROLE aetheris_app WITH LOGIN PASSWORD '<managed-secret>';
#
#     In production/staging, the password MUST come from a secrets manager
#     (Vault, AWS Secrets Manager, k8s secrets, etc.) and be rotated regularly.
#     For local development only:
#
#       ALTER ROLE aetheris_app WITH LOGIN PASSWORD 'aetheris_app';
#
# APP_DATABASE_URL=postgres://aetheris_app:<password>@localhost:5432/memory
# ─────────────────────────────────────────────────────────
#
# ─────────────────────────────────────────────────────────
# 管理员数据库连接（可选 — 默认禁用）
# 仅用于跨租户运维操作（如 Qdrant tenant-metadata backfill）。
# 此连接绕过 Row Level Security，必须使用 owner/BYPASSRLS 角色。
# 未设置时，backfill 端点返回明确错误。
# APP_DB_ADMIN_URL=postgres://memory:memory@localhost:5432/memory
# ─────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# 数据库自动迁移（默认关闭 = false）
# 开启后应用启动时自动运行 sqlx 迁移，需要 DDL 权限（CREATE on schema）。
# 生产环境应保持关闭，由独立的 owner/superuser 步骤运行迁移
# （如 CI 中的 `sqlx migrate run` 或 dev-infra.sh）。
# 仅在本地开发且数据库连接本身持有 DDL 权限时开启。
# APP_DB_AUTO_MIGRATE=true
# ─────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# 治理中间件故障模式（默认 fail-closed = true）
# 当企业钩子未初始化或租户上下文缺失时，中间件返回 403 Forbidden。
# 设为 false 可切换到 fail-open 模式，适用于迁移期间或调试场景。
# 生产环境强烈建议保持默认值（true 或不设置）。
# GOVERNANCE_FAIL_CLOSED=false
# ─────────────────────────────────────────────────────────
