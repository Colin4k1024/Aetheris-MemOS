# ─────────────────────────────────────────────────────────
# Aetheris-MemOS — 环境变量模板
# 复制为 .env 并填写真实值，切勿提交 .env 到版本库
# ─────────────────────────────────────────────────────────

# Docker Compose requires every value below. Generate non-secret local values with:
# openssl rand -hex 32
# Do not commit the resulting .env file.

# JWT signing secret (at least 32 random characters)
JWT_SECRET=

# PostgreSQL password
POSTGRES_PASSWORD=

# Neo4j password (must match docker-compose NEO4J_AUTH)
NEO4J_PASSWORD=

# Grafana administrator password
GRAFANA_PASSWORD=

# Memory infrastructure is localhost-only by default. Set this explicitly only
# when remote access is required and host firewall/network controls are in place.
# INFRA_BIND_ADDRESS=0.0.0.0
