# ─────────────────────────────────────────────────────────
# Aetheris-MemOS — 环境变量模板
# 复制为 .env 并填写真实值，切勿提交 .env 到版本库
# ─────────────────────────────────────────────────────────

# JWT 签名密钥（生产环境必须设置，至少 32 个随机字符）
JWT_SECRET=change-me-in-production-32chars

# Neo4j 数据库密码（与 docker-compose NEO4J_AUTH 保持一致）
NEO4J_PASSWORD=password
