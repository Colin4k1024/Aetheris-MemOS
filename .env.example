# ─────────────────────────────────────────────────────────
# Aetheris-MemOS — 环境变量模板
# 复制为 .env 并填写真实值，切勿提交 .env 到版本库
# ─────────────────────────────────────────────────────────

# JWT 签名密钥（必须设置：认证默认开启，占位/过短或未设置将拒绝启动）
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# Neo4j 数据库密码（与 docker-compose NEO4J_AUTH 保持一致）
NEO4J_PASSWORD=password
