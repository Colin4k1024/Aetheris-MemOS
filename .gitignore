# Python build artifacts
sdks/python/*.egg-info/
# Anchorless so it matches every package dir, not just sdks/python/ itself —
# CPython writes a __pycache__ next to each module, so the old anchored pattern
# missed adaptive_memory/__pycache__/ and tests/__pycache__/.
__pycache__/
*.py[cod]
sdks/python/.eggs/
.gstack/
docker-compose.override.yml
